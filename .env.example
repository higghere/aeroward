# AeroWard Environment Configuration
# Node.js Fastify API Server
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Database Settings (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://aeroward_user:aeroward_secret_2026@localhost:5432/aeroward_db
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis Cache & Queue Settings (BullMQ)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=aeroward:
CACHE_TTL_SECONDS=300

# Earth Observation & Telemetry Data Providers
CPCB_API_URL=https://api.cpcb.gov.in/caaqms/v1
CPCB_API_KEY=your_cpcb_telemetry_key_here
SENTINEL_TROPOMI_API_URL=https://catalogue.dataspace.copernicus.eu/resto/api
SENTINEL_API_KEY=your_copernicus_data_space_key_here
ECMWF_CDS_API_URL=https://cds.climate.copernicus.eu/api/v2
ECMWF_API_KEY=your_ecmwf_cds_key_here
GFS_NWP_FEED_URL=https://nomads.ncep.noaa.gov/pub/data/nccf/com/gfs/prod

# Platform Operation Mode
DEMO_MODE=true
ENABLE_SCHEDULED_INGESTION=true
LOG_LEVEL=info

# Frontend Client Settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:4000/api/v1
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
